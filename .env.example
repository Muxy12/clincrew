# ---------------------------------------------------------------------------
# Mohamed Debbah — CRA website — environment variables
# Copy this file to `.env.local` and fill in real values before deployment.
# Never commit `.env.local`. All values here are placeholders.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph, hreflang).
# No trailing slash. Set this to the production domain on deploy.
# Production: https://clincrew.net
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form email delivery (Resend) --------------------------------
# Get an API key at https://resend.com (free tier available).
# If RESEND_API_KEY is left empty, the contact API returns a clear
# "email not configured" response and never silently drops a message.
RESEND_API_KEY=

# Verified sender address on your Resend domain (e.g. contact@mohameddebbah.com).
# Must belong to a domain you have verified in Resend.
CONTACT_FROM_EMAIL=

# Where contact form submissions are delivered (Mohamed's inbox).
CONTACT_TO_EMAIL=

# --- Anti-spam: Cloudflare Turnstile (optional) --------------------------
# Create a free widget at https://dash.cloudflare.com/?to=/:account/turnstile
# and paste the two keys below. When BOTH are left empty, the contact form
# works without the challenge; when set, the widget appears and the server
# verifies every submission. NEXT_PUBLIC_* is exposed to the browser (site
# key is meant to be public); the secret key stays server-side only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
